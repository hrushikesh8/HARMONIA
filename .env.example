# Harmonia configuration overrides
# Copy this to .env and fill in your values.
# All variables are optional — sensible defaults are in config/default.toml.

# Database path (default: data/harmonia.db)
# HARMONIA_DB_PATH=data/harmonia.db

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# HARMONIA_LOG_LEVEL=INFO

# Log file path (default: None — logs to stderr)
# HARMONIA_LOG_FILE=data/harmonia.log

# Music directories to manage (comma-separated)
# HARMONIA_MUSIC_DIRS=~/Music,/mnt/external/Music

# MusicBrainz (Phase 2)
# HARMONIA_MUSICBRAINZ_ENABLED=true
